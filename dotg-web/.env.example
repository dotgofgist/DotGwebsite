# DotG public Supabase configuration
#
# These variables are intentionally NEXT_PUBLIC_* because the browser Supabase
# client needs the project URL and anon key. Do not add a service role key to
# this app, .env.local, Vercel, or client-side code.

# Supabase project URL.
# Local Supabase CLI example: http://127.0.0.1:54321
# Hosted Supabase example: https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon public key for Auth and RLS-protected public/client access.
# Use a placeholder in examples; never commit a real project value.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical public site URL for metadata, sitemap, robots, and smoke tests.
# Local example: http://localhost:3000
# Production example: https://dotg.example.com
NEXT_PUBLIC_SITE_URL=

# Vercel provides VERCEL_ENV automatically on the server.
# Set NEXT_PUBLIC_VERCEL_ENV only if client-side environment detection is needed.
# NEXT_PUBLIC_VERCEL_ENV=preview

# Optional Playwright E2E overrides.
# Defaults target local Next.js and local Supabase.
# E2E_BASE_URL=http://localhost:3000
# E2E_SUPABASE_URL=http://127.0.0.1:54321
# E2E_TEST_PASSWORD=
# E2E_ALLOW_REMOTE=false
