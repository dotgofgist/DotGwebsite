# DotG CI example environment.
# Do not put real tokens, DB passwords, service role keys, or storage states in this file.

CI=true
SUPABASE_TELEMETRY_DISABLED=1

# Local-only E2E defaults. The E2E runner reads anon/service-role keys from `supabase status`.
E2E_BASE_URL=http://localhost:3000
E2E_SUPABASE_URL=http://127.0.0.1:54321
E2E_ALLOW_REMOTE=false
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Deployment smoke tests require an explicit target URL at runtime.
# SMOKE_BASE_URL=https://example-preview.vercel.app
